# Kopiere diese Datei nach .env.local (lokale Entwicklung) bzw. trage die
# Werte in Vercel unter Project Settings → Environment Variables ein.
# Nichts davon landet jemals im Browser – alle Zugriffe laufen über die
# Next.js API-Routes (app/api/**) auf dem Server.

# --- App-Zugriff (Pflicht) ---
# Erst-Passwort, mit dem sich die App im Browser entsperren lässt. Beim ersten
# erfolgreichen Login wird es als scrypt-Hash in Firebase (auth/passwordHash)
# abgelegt; ab dann zählt nur noch der Hash und das Passwort lässt sich in den
# App-Einstellungen ändern (dieser Env-Wert wird dann ignoriert).
APP_PASSWORD=

# Optional: eigener Schlüssel für die Session-Cookies. Falls leer, wird
# APP_PASSWORD dafür mitverwendet.
SESSION_SECRET=

# --- GitHub Actions Steuerung (Pflicht für Scrape/Upload-Buttons) ---
# Fine-grained oder classic PAT mit "repo" + "workflow" Rechten auf das Repo.
GITHUB_TOKEN=
GITHUB_USER=yildizog
GITHUB_REPO=AutoBerichtsheft

# --- Firebase Realtime Database (Pflicht für Berichte/Status/Einstellungen) ---
FIREBASE_URL=https://autoberichtsheft-default-rtdb.europe-west1.firebasedatabase.app/
FIREBASE_SECRET=

# --- Gemini KI-Korrektur (optional) ---
GEMINI_API_KEY=

# --- E-Mail-Versand für den Wochen-Digest (optional, separat vom Alarm-Mailer) ---
EMAIL_HOST=
EMAIL_PORT=465
EMAIL_USER=
EMAIL_PASS=

# --- Cron-Absicherung (empfohlen) ---
# Sobald gesetzt, hängt Vercel automatisch "Authorization: Bearer <Wert>" an
# Cron-Aufrufe an; /api/cron/weekly-digest prüft das.
CRON_SECRET=
